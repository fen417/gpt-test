{
  "name": "gpt-test-sector-09",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "description": "SECTOR 09 — conquest in your browser",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-budgets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pistols": "vite build --config scripts/pistol-preview.config.mjs && vite preview --config scripts/pistol-preview.config.mjs",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "bench": "node scripts/bench-sim.mjs",
    "assets:hands": "node scripts/build-fps-hands.mjs && node scripts/pack-fps-hands.mjs",
    "assets:soldiers": "node scripts/bake-soldiers.mjs",
    "assets:surfaces": "node scripts/bake-surfaces.mjs",
    "assets:shadows": "node scripts/bake-ground-shadows.mjs",
    "assets:audio": "node scripts/prepare-runtime-audio.mjs",
    "assets:explosion": "node scripts/align-explosion-audio.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "meshoptimizer": "1.3.0",
    "three": "0.181.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.1",
    "basis_universal": "1.16.4-1",
    "ffmpeg-static": "5.3.0",
    "rollup-plugin-visualizer": "7.1.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=24"
  }
}
