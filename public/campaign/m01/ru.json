{
  "speakers": {
    "orlov": "Лейтенант Орлов",
    "duran": "Сержант Гари Дюран",
    "lasko": "Санитар Тео Ласко",
    "bruno": "Радист Бруно Валь",
    "kane": "Рядовой Кейн",
    "courier": "Раненый связной",
    "officer": "Офицер Восточного корпуса",
    "sentry": "Часовой Восточного корпуса"
  },
  "objectives": {
    "follow": "Следуй за сержантом",
    "ridge": "Убери дозор на гряде",
    "depot": "Уничтожь топливо и грузовики",
    "village": "Доберись до деревни",
    "station": "Захвати здание радиостанции",
    "defend": "Защити радиста",
    "documents": "Найди документы офицера",
    "courier": "Спаси связного и выведи к восточной дороге"
  },
  "lines": {
    "m01.orlov.brief01": {
      "speaker": "orlov",
      "text": "В два часа ночи грузовики высадят вас у сухого русла.",
      "duration": 4.36,
      "priority": 3,
      "direction": "Брифинг; спокойно",
      "audio": "voice/m01.orlov.brief01.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "orlov"
      }
    },
    "m01.orlov.brief02": {
      "speaker": "orlov",
      "text": "Восточный корпус держит Аль-Хадру. В бывшей школе работает их радиостанция.",
      "duration": 6.56,
      "priority": 3,
      "direction": "Брифинг",
      "audio": "voice/m01.orlov.brief02.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "orlov"
      }
    },
    "m01.orlov.brief03": {
      "speaker": "orlov",
      "text": "Маршрут: гряда, тыловой склад, деревня. Не выходите на освещённые участки.",
      "duration": 6.76,
      "priority": 3,
      "direction": "Брифинг",
      "audio": "voice/m01.orlov.brief03.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "orlov"
      }
    },
    "m01.orlov.brief04": {
      "speaker": "orlov",
      "text": "Уничтожьте топливо и грузовики. Затем захватите станцию и удерживайте до подхода снабжения.",
      "duration": 6.96,
      "priority": 3,
      "direction": "Брифинг",
      "audio": "voice/m01.orlov.brief04.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "orlov"
      }
    },
    "m01.orlov.brief05": {
      "speaker": "orlov",
      "text": "Если поднимут тревогу — продолжайте. Стрелять первыми не торопитесь.",
      "duration": 5.66,
      "priority": 3,
      "direction": "Брифинг",
      "audio": "voice/m01.orlov.brief05.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "orlov"
      }
    },
    "m01.duran.landing01": {
      "speaker": "duran",
      "text": "Мартен, за мной. Ласко — замыкающий. Валь, проверь связь.",
      "duration": 5.56,
      "priority": 3,
      "direction": "Высадка; вполголоса",
      "audio": "voice/m01.duran.landing01.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.bruno.landing02": {
      "speaker": "bruno",
      "text": "Связь есть. Надеюсь, местные уже спят.",
      "duration": 3.86,
      "priority": 3,
      "direction": "Высадка; сухая шутка",
      "audio": "voice/m01.bruno.landing02.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "bruno"
      }
    },
    "m01.lasko.landing03": {
      "speaker": "lasko",
      "text": "В такую темноту и собственную тень потеряешь.",
      "duration": 3.86,
      "priority": 3,
      "direction": "Высадка; нервно",
      "audio": "voice/m01.lasko.landing03.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "lasko"
      }
    },
    "m01.duran.landing04": {
      "speaker": "duran",
      "text": "Темнота сегодня на нашей стороне. В русло, живо.",
      "duration": 4.16,
      "priority": 3,
      "direction": "Высадка",
      "audio": "voice/m01.duran.landing04.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.duran.follow": {
      "speaker": "duran",
      "text": "Держись рядом, Мартен. До гряды идём по руслу.",
      "duration": 3.96,
      "priority": 3,
      "direction": "Этап 1",
      "audio": "voice/m01.duran.follow.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.duran.crouch": {
      "speaker": "duran",
      "text": "Патруль на берегу. Присядь. Не показывайся на фоне неба.",
      "duration": 4.66,
      "priority": 1,
      "direction": "Присед",
      "audio": "voice/m01.duran.crouch.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.duran.prone": {
      "speaker": "duran",
      "text": "Если укрытие низкое — ложись. Здесь спешка выдаёт нас.",
      "duration": 4.86,
      "priority": 1,
      "direction": "Ползание",
      "audio": "voice/m01.duran.prone.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.bruno.patrol": {
      "speaker": "bruno",
      "text": "Двое наверху. Пока нас не заметили.",
      "duration": 3.16,
      "priority": 3,
      "direction": "Первый патруль",
      "audio": "voice/m01.bruno.patrol.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "bruno"
      }
    },
    "m01.duran.ridge": {
      "speaker": "duran",
      "text": "На гряде пулемётный пост. Уберём дозор и пойдём дальше.",
      "duration": 4.56,
      "priority": 3,
      "direction": "Этап 2",
      "audio": "voice/m01.duran.ridge.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.duran.knife": {
      "speaker": "duran",
      "text": "Обойди со стороны траншеи. Ножом со спины — без единого звука.",
      "duration": 5.36,
      "priority": 1,
      "direction": "Нож",
      "audio": "voice/m01.duran.knife.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.kane.grenade": {
      "speaker": "kane",
      "text": "Граната достанет их за мешками. Только предупреди нас.",
      "duration": 4.36,
      "priority": 3,
      "direction": "Шумный подход",
      "audio": "voice/m01.kane.grenade.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "kane"
      }
    },
    "m01.duran.objective": {
      "speaker": "duran",
      "text": "Хорошая работа. Продолжаем.",
      "duration": 2.76,
      "priority": 3,
      "direction": "Цель выполнена",
      "audio": "voice/m01.duran.objective.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.duran.ridgeClear": {
      "speaker": "duran",
      "text": "Гряда наша. Дальше склад. За дюнами укрытий больше.",
      "duration": 4.76,
      "priority": 3,
      "direction": "КП 1",
      "audio": "voice/m01.duran.ridgeClear.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.bruno.road": {
      "speaker": "bruno",
      "text": "По дороге быстрее. И смотреть на нас будут со всех сторон.",
      "duration": 3.96,
      "priority": 3,
      "direction": "Прямой путь",
      "audio": "voice/m01.bruno.road.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "bruno"
      }
    },
    "m01.duran.depot": {
      "speaker": "duran",
      "text": "Топливо и три грузовика. Два заряда — и отходим.",
      "duration": 4.46,
      "priority": 3,
      "direction": "Этап 3",
      "audio": "voice/m01.duran.depot.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.duran.charges": {
      "speaker": "duran",
      "text": "Держи клавишу взаимодействия у метки. Взрыв через двадцать пять секунд после второго заряда.",
      "duration": 6.56,
      "priority": 1,
      "direction": "Заряды",
      "audio": "voice/m01.duran.charges.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.kane.wounded": {
      "speaker": "kane",
      "text": "А! Ногу зацепило! Мартен, помоги!",
      "duration": 4.06,
      "priority": 3,
      "direction": "Скриптовое ранение",
      "audio": "voice/m01.kane.wounded.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "kane"
      }
    },
    "m01.lasko.kaneDown": {
      "speaker": "lasko",
      "text": "Кейн ранен! Подойди, зажми взаимодействие и держи пять секунд!",
      "duration": 5.16,
      "priority": 3,
      "direction": "Реанимация",
      "audio": "voice/m01.lasko.kaneDown.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "lasko"
      }
    },
    "m01.kane.revived": {
      "speaker": "kane",
      "text": "Думал, так тут и останусь. Спасибо. Прикрою.",
      "duration": 4.76,
      "priority": 3,
      "direction": "Кейн спасён",
      "audio": "voice/m01.kane.revived.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "kane"
      }
    },
    "m01.lasko.kaneLost": {
      "speaker": "lasko",
      "text": "Он без сознания. Отмечаю место для санитаров. Нам нужно идти.",
      "duration": 5.16,
      "priority": 3,
      "direction": "Кейн выбыл",
      "audio": "voice/m01.lasko.kaneLost.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "lasko"
      }
    },
    "m01.duran.chargeOne": {
      "speaker": "duran",
      "text": "Первый готов. Теперь второй, у другой группы грузовиков.",
      "duration": 4.36,
      "priority": 3,
      "direction": "Первый заряд",
      "audio": "voice/m01.duran.chargeOne.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.duran.chargeTwo": {
      "speaker": "duran",
      "text": "Оба заряда стоят. Двадцать пять секунд. Всем отойти от топлива!",
      "duration": 5.16,
      "priority": 3,
      "direction": "Второй заряд",
      "audio": "voice/m01.duran.chargeTwo.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.bruno.fuse": {
      "speaker": "bruno",
      "text": "Сейчас рванёт. Держите головы ниже!",
      "duration": 4.36,
      "priority": 3,
      "direction": "Пять секунд до взрыва",
      "audio": "voice/m01.bruno.fuse.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "bruno"
      }
    },
    "m01.duran.depotBoom": {
      "speaker": "duran",
      "text": "Склад уничтожен. Проверить оружие. Идём к деревне.",
      "duration": 4.46,
      "priority": 3,
      "direction": "Склад уничтожен",
      "audio": "voice/m01.duran.depotBoom.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.officer.mid01": {
      "speaker": "officer",
      "text": "Склад горит! Поднять гарнизон, перекрыть подходы к школе!",
      "duration": 4.86,
      "priority": 3,
      "direction": "Средняя катсцена; радио",
      "audio": "voice/m01.officer.mid01.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "officer"
      }
    },
    "m01.bruno.mid02": {
      "speaker": "bruno",
      "text": "Они запрашивают подкрепление. Тихая прогулка закончилась.",
      "duration": 4.06,
      "priority": 3,
      "direction": "Средняя катсцена",
      "audio": "voice/m01.bruno.mid02.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "bruno"
      }
    },
    "m01.duran.mid03": {
      "speaker": "duran",
      "text": "Тогда заставим их смотреть не туда. Мартен, выбирай подход.",
      "duration": 4.86,
      "priority": 3,
      "direction": "Средняя катсцена",
      "audio": "voice/m01.duran.mid03.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.duran.village": {
      "speaker": "duran",
      "text": "К школе можно пройти через рощу или по сухому каналу справа.",
      "duration": 4.66,
      "priority": 3,
      "direction": "Этап 4",
      "audio": "voice/m01.duran.village.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.lasko.courier": {
      "speaker": "lasko",
      "text": "В крайнем доме наш связной. Ещё дышит!",
      "duration": 3.76,
      "priority": 3,
      "direction": "Необязательная цель",
      "audio": "voice/m01.lasko.courier.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "lasko"
      }
    },
    "m01.courier.help": {
      "speaker": "courier",
      "text": "Свои?.. Я не могу встать. Помогите добраться до дороги.",
      "duration": 6.06,
      "priority": 3,
      "direction": "Связной обнаружен",
      "audio": "voice/m01.courier.help.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "courier"
      }
    },
    "m01.courier.saved": {
      "speaker": "courier",
      "text": "Дойду. Только не оставляйте меня здесь.",
      "duration": 3.56,
      "priority": 3,
      "direction": "Связной поднят",
      "audio": "voice/m01.courier.saved.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "courier"
      }
    },
    "m01.courier.evacuated": {
      "speaker": "courier",
      "text": "Спасибо, Мартен. В машине есть ещё аптечка. Возьми.",
      "duration": 5.16,
      "priority": 3,
      "direction": "Связной эвакуирован",
      "audio": "voice/m01.courier.evacuated.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "courier"
      }
    },
    "m01.duran.station": {
      "speaker": "duran",
      "text": "Радиостанция впереди. Вход с двух сторон. Проверяй углы.",
      "duration": 4.46,
      "priority": 3,
      "direction": "Этап 5; КП 3",
      "audio": "voice/m01.duran.station.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.officer.call": {
      "speaker": "officer",
      "text": "Говорит станция Аль-Хадра. Пришлите резерв! Немедленно!",
      "duration": 4.86,
      "priority": 3,
      "direction": "Офицер вызывает резерв",
      "audio": "voice/m01.officer.call.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "officer"
      }
    },
    "m01.bruno.officerStopped": {
      "speaker": "bruno",
      "text": "Офицер не успел передать вызов. Одной проблемой меньше.",
      "duration": 4.46,
      "priority": 3,
      "direction": "Вызов прерван",
      "audio": "voice/m01.bruno.officerStopped.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "bruno"
      }
    },
    "m01.duran.documents": {
      "speaker": "duran",
      "text": "Документы офицера. Забери — в штабе разберутся.",
      "duration": 4.06,
      "priority": 3,
      "direction": "Документы",
      "audio": "voice/m01.duran.documents.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.bruno.radioStart": {
      "speaker": "bruno",
      "text": "Станция наша. Мне нужно полторы минуты. Прикройте входы.",
      "duration": 4.36,
      "priority": 3,
      "direction": "Этап 6",
      "audio": "voice/m01.bruno.radioStart.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "bruno"
      }
    },
    "m01.duran.defend": {
      "speaker": "duran",
      "text": "Держим школу! Валь должен закончить передачу.",
      "duration": 4.36,
      "priority": 3,
      "direction": "Оборона",
      "audio": "voice/m01.duran.defend.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.kane.waveOne": {
      "speaker": "kane",
      "text": "На восточной дороге движение! Идут к нам!",
      "duration": 5.06,
      "priority": 3,
      "direction": "Волна 1",
      "audio": "voice/m01.kane.waveOne.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "kane"
      }
    },
    "m01.duran.waveTwo": {
      "speaker": "duran",
      "text": "Ещё одна группа! Не стойте у окон!",
      "duration": 3.86,
      "priority": 3,
      "direction": "Волна 2",
      "audio": "voice/m01.duran.waveTwo.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "m01.lasko.sniper": {
      "speaker": "lasko",
      "text": "Снайпер на крыше! Не высовывайтесь под вспышки!",
      "duration": 4.36,
      "priority": 3,
      "direction": "Снайпер",
      "audio": "voice/m01.lasko.sniper.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "lasko"
      }
    },
    "m01.bruno.radioHalf": {
      "speaker": "bruno",
      "text": "Половина ушла. Держитесь, ещё немного!",
      "duration": 3.76,
      "priority": 3,
      "direction": "45 секунд передачи",
      "audio": "voice/m01.bruno.radioHalf.ogg",
