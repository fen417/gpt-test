{
  "speakers": {
    "holt": "Капитан Холт · Сокол-1",
    "grey": "Старик Грей · Сокол-4",
    "bale": "Ник Бэйл · Сокол-8",
    "duran": "Сержант Дюран",
    "bruno": "Бруно Валь",
    "dargo": "Майор Дарго",
    "crew": "Экипаж Сокол-7",
    "kane": "Рядовой Кейн",
    "ray": "Тимо Рэй · механик-водитель",
    "kim": "Рафа Ким · заряжающий",
    "vos": "Ирвин Вос · Сокол-7",
    "lasko": "Тео Ласко",
    "reserveMedic": "Санитар взвода"
  },
  "objectives": {
    "march": "Держать строй",
    "intercept": "Разбей колонну до подхода к деревне",
    "battle": "Уничтожить бронетехнику противника",
    "village": "Войдите в деревню, прикройте взвод и уничтожьте ПТ-орудия",
    "debrief": "Заберите приказ у штабного танка",
    "finale": "Приказ получен · перехват вражеского эфира"
  },
  "lines": {
    "holt.brief01": {
      "speaker": "holt",
      "text": "Рота «Сокол», выходим на сигнал «Маяк». Аль-Хадра ждёт помощи.",
      "duration": 5.16,
      "audio": "voice/holt.brief01.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "holt"
      }
    },
    "holt.brief02": {
      "speaker": "holt",
      "text": "Восточный корпус идёт к деревне. Мы перехватим колонну на подходе.",
      "duration": 5.16,
      "audio": "voice/holt.brief02.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "holt"
      }
    },
    "holt.brief03": {
      "speaker": "holt",
      "text": "Вос, держись рядом с ротой. По моей команде — удар с фланга.",
      "duration": 5.26,
      "audio": "voice/holt.brief03.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "holt"
      }
    },
    "holt.hold": {
      "speaker": "holt",
      "text": "«Сокол», держать строй!",
      "duration": 2.96,
      "audio": "voice/holt.hold.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "holt"
      }
    },
    "grey.dust": {
      "speaker": "grey",
      "text": "Пыль на востоке!",
      "duration": 2.06,
      "audio": "voice/grey.dust.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "grey"
      }
    },
    "bale.loss": {
      "speaker": "holt",
      "text": "Восьмой, отвечай! Чёрт… «Сокол-восемь» потерян! Держим строй!",
      "duration": 7.56,
      "audio": "voice/bale.loss.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "holt"
      }
    },
    "duran.support": {
      "speaker": "duran",
      "text": "Нам нужна поддержка бронетехники на площади!",
      "duration": 3.56,
      "audio": "voice/duran.support.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "bruno.signal": {
      "speaker": "bruno",
      "text": "«Сокол», примите сигнал — выдвигаемся.",
      "duration": 3.06,
      "audio": "voice/bruno.signal.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "bruno"
      }
    },
    "dargo.final": {
      "speaker": "dargo",
      "text": "Вы удержали Аль-Хадру. Но у карьера вас уже ждут. Маяк не останется вашим.",
      "duration": 6.56,
      "audio": "voice/dargo.final.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "dargo"
      }
    },
    "crew.loaded": {
      "speaker": "kim",
      "text": "Заряжено!",
      "duration": 1.86,
      "audio": "voice/crew.loaded.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "kim"
      }
    },
    "duran.signal": {
      "speaker": "duran",
      "text": "«Сокол», Аль-Хадра на связи. Ждём вас. Бруно больше не отвечает.",
      "duration": 5.66,
      "audio": "voice/duran.signal.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "kane.support": {
      "speaker": "kane",
      "text": "Здесь Кейн. Держу площадь. Работайте по броне!",
      "duration": 4.36,
      "audio": "voice/kane.support.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "kane"
      }
    },
    "duran.underFire": {
      "speaker": "duran",
      "text": "Танки противника прорываются! Без поддержки нам не удержаться.",
      "duration": 5.36,
      "audio": "voice/duran.underFire.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "bale.ready": {
      "speaker": "bale",
      "text": "Седьмой, я справа от тебя. Не отстану!",
      "duration": 3.96,
      "audio": "voice/bale.ready.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "bale"
      }
    },
    "grey.tactics": {
      "speaker": "grey",
      "text": "Не стойте бортом! Огонь с остановки, затем меняйте позицию.",
      "duration": 5.16,
      "audio": "voice/grey.tactics.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "grey"
      }
    },
    "grey.repair": {
      "speaker": "grey",
      "text": "Вос, броня ещё держит. Остановись и прикажи экипажу ремонтировать машину.",
      "duration": 6.06,
      "audio": "voice/grey.repair.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "grey"
      }
    },
    "grey.cover": {
      "speaker": "grey",
      "text": "Вторая группа справа от площади! Прикрою вас.",
      "duration": 3.96,
      "audio": "voice/grey.cover.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "grey"
      }
    },
    "crew.repair": {
      "speaker": "ray",
      "text": "Ремонт закончен. Всё, дым ушёл. Можно трогаться!",
      "duration": 4.46,
      "audio": "voice/crew.repair.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "ray"
      }
    },
    "duran.targets": {
      "speaker": "duran",
      "text": "Пехота у восточных домов! Два противотанковых орудия у дороги. Уберите их!",
      "duration": 5.96,
      "audio": "voice/duran.targets.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "holt.lastWave": {
      "speaker": "holt",
      "text": "Последняя группа противника! Не подпускайте их к нашим пехотинцам.",
      "duration": 5.66,
      "audio": "voice/holt.lastWave.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "holt"
      }
    },
    "duran.saved": {
      "speaker": "duran",
      "text": "Площадь наша. Спасибо, Сокол. Осмотрите подбитую штабную машину: там вражеские приказы.",
      "duration": 6.76,
      "audio": "voice/duran.saved.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "duran"
      }
    },
    "vos.forward": {
      "speaker": "vos",
      "text": "Рота, вперёд!",
      "duration": 2.16,
      "audio": "voice/vos.forward.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "vos"
      }
    },
    "vos.fire": {
      "speaker": "vos",
      "text": "Огонь по отмеченной цели!",
      "duration": 3.76,
      "audio": "voice/vos.fire.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "vos"
      }
    },
    "vos.hold": {
      "speaker": "vos",
      "text": "Держать позицию!",
      "duration": 2.16,
      "audio": "voice/vos.hold.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "vos"
      }
    },
    "vos.help": {
      "speaker": "vos",
      "text": "Прикрыть Сокол семь!",
      "duration": 2.36,
      "audio": "voice/vos.help.ogg",
      "synthesis": {
        "engine": "ElevenLabs",
        "model": "eleven_v4",
        "profile": "vos"
      }
    },
    "holt.allyHit": {
      "speaker": "holt",
      "text": "У нас горит машина! Сокол, прикройте экипаж!",
      "duration": 4.06,
      "audio": "voice/holt.allyHit.ogg"
    },
    "ray.allyLoss": {
      "speaker": "ray",
      "text": "Чёрт! Наш танк подбит! Отходим за укрытие!",
      "duration": 4.66,
      "audio": "voice/ray.allyLoss.ogg"
    },
    "vos.enemyDown": {
      "speaker": "vos",
      "text": "Попали! Один готов! Переноси огонь!",
      "duration": 3.86,
      "audio": "voice/vos.enemyDown.ogg"
    },
    "kim.enemyDown": {
      "speaker": "kim",
      "text": "Есть! Вражеская машина встала! Вот это удар!",
      "duration": 5.16,
      "audio": "voice/kim.enemyDown.ogg"
    },
    "grey.enemyDown": {
      "speaker": "grey",
      "text": "Хорошо приложили! Держим строй, ещё не всё!",
      "duration": 4.96,
      "audio": "voice/grey.enemyDown.ogg"
    },
    "holt.retreat": {
      "speaker": "holt",
      "text": "Три машины разворачиваются! Следите за ними, строй держать!",
      "duration": 4.66,
      "audio": "voice/holt.retreat.ogg"
    },
    "kim.fire": {
      "speaker": "kim",
      "text": "Внутри дым! Горим! Стой, надо потушить!",
      "duration": 4.36,
      "audio": "voice/kim.fire.ogg"
    },
    "lasko.medkitDrop": {
      "speaker": "lasko",
      "text": "Аптечка у меня! Раненые, подходите по одному!",
      "duration": 4.16,
      "audio": "voice/lasko.medkitDrop.ogg"
    },
    "lasko.revive": {
      "speaker": "lasko",
      "text": "Держись, я подниму тебя. Остальные, прикройте!",
      "duration": 4.36,
      "audio": "voice/lasko.revive.ogg"
    },
    "reserveMedic.medkitDrop": {
      "speaker": "reserveMedic",
      "text": "Аптечка на земле! Подлечитесь и держитесь вместе!",
      "duration": 4.36,
      "audio": "voice/reserveMedic.medkitDrop.ogg"
    },
    "reserveMedic.revive": {
      "speaker": "reserveMedic",
      "text": "Не вставай сам. Я тебя подниму. Прикройте нас!",
      "duration": 4.86,
      "audio": "voice/reserveMedic.revive.ogg"
    },
    "holt.contactReport": {
      "speaker": "holt",
      "text": "Правый фланг видит броню у гряды! Вос, что у тебя?",
      "duration": 4.36,
      "audio": "voice/holt.contactReport.ogg"
    },
    "vos.contactReply": {
      "speaker": "vos",
      "text": "Вижу машины слева от гряды! Седьмой открывает огонь, держите фланг!",
      "duration": 5.46,
      "audio": "voice/vos.contactReply.ogg"
    }
  }
}
